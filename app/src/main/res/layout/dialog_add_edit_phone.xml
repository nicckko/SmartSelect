<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/divider"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Phone"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill in the phone specifications"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="0dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text_secondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Scrollable form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── IMAGE PICKER ─────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE PHOTO"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textColor="@color/text_tertiary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_phone_preview"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_image_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷"
                        android:textSize="36sp"
                        android:layout_marginBottom="8dp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_image_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No image selected"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pick_image"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="📁  Choose from Gallery"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:minWidth="0dp"
                        style="@style/SmartSelect.Button.Primary"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BASIC INFO ───────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BASIC INFO"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textColor="@color/text_tertiary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Brand (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Brand *"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Model (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Model *"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Price + Stock (keep as plain input) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Price (₱) *"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Stock Qty"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_stock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Category Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Category *"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actv_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="0" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── SPECIFICATIONS ───────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPECIFICATIONS"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textColor="@color/text_tertiary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- RAM (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="RAM (e.g. 8GB)"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_ram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Storage (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Storage (e.g. 128GB)"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Battery (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Battery (e.g. 5000mAh)"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_battery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Chipset (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Chipset"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_chipset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Camera (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Camera (e.g. 108MP Triple OIS)"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_camera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Display (AutoComplete) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Display (e.g. 6.7&quot; AMOLED 120Hz)"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Additional Specs (NEW) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADDITIONAL SPECS"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textColor="@color/text_tertiary"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- OS -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Operating System"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_os"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Network -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Network"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_network"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Weight + Dimensions row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Weight"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView
                        android:id="@+id/et_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Dimensions"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView
                        android:id="@+id/et_dimensions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Build + Protection row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Build"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView
                        android:id="@+id/et_build"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Protection"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView
                        android:id="@+id/et_protection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- GPU -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="GPU"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_gpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Charging -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Charging"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="dropdown_menu">
                <AutoCompleteTextView
                    android:id="@+id/et_charging"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sensors + Colors row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Sensors"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView
                        android:id="@+id/et_sensors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Colors"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView
                        android:id="@+id/et_colors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Release Date -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Release Date (e.g., 2024-01)"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:hintTextColor="@color/accent" app:boxStrokeColor="@color/divider"
                app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_release_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Best Value toggle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐  Mark as Best Value"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adds a badge on the phone card"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_best_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer: progress + buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <ProgressBar
                    android:id="@+id/progress_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="Cancel"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"
                        style="@style/SmartSelect.Button.Outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="2"
                        android:text="Save Phone"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        style="@style/SmartSelect.Button.Primary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>